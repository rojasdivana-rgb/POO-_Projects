@startuml arquitectura
!theme default
title Arquitectura del Sistema de Ventas Lamborghini

package "Capa de Presentación" {
    component [CLI] as cli
}

package "Capa de Lógica de Negocio" {
    component [VentaProcess] as venta_proc
    component [ReporteVentasProcess] as reporte_proc
    component [FechaUtil] as fecha_util
}

package "Capa de Acceso a Datos (Repository Pattern)" {
    component [AutoRepository] as auto_repo
    component [VentaRepository] as venta_repo
}

package "Capa de Modelos" {
    component [Auto] as auto_model
    component [Cliente] as cliente_model
    component [Venta] as venta_model
}

package "Punto de Entrada" {
    component [Main] as main
}

' Relaciones
main --> cli: inicia
cli --> venta_proc: controla flujo
cli --> reporte_proc: genera reportes
cli --> auto_repo: obtiene autos
cli --> venta_repo: guarda ventas

venta_proc --> venta_repo: persiste datos
venta_proc --> auto_repo: consulta catálogo
venta_proc --> venta_model: crea transacciones

reporte_proc --> venta_model: lee datos
reporte_proc --> auto_model: muestra detalles
reporte_proc --> fecha_util: formatea fechas

auto_repo --> auto_model: contiene instancias
venta_repo --> venta_model: contiene instancias

venta_model --> cliente_model: asocia cliente
venta_model --> auto_model: contiene autos

@enduml
