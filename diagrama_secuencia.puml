@startuml flujo_venta
!theme default
title Flujo de Creación de Venta en Sistema Lamborghini

actor Usuario
participant CLI
participant VentaProcess
participant AutoRepository
participant VentaRepository
participant ReporteVentasProcess

Usuario -> CLI: iniciar()
CLI -> CLI: mostrarMenuPrincipal()
Usuario -> CLI: seleccionar opción 1

CLI -> CLI: capturarDatosCliente()
CLI -> Usuario: solicitar datos
Usuario -> CLI: nombre, apellido, teléfono, email

CLI -> VentaProcess: iniciarVenta(cliente)
VentaProcess -> VentaProcess: new Venta(cliente)

loop Mientras usuario desee agregar autos
    CLI -> CLI: mostrarCatalogo()
    CLI -> AutoRepository: obtenerTodos()
    AutoRepository -> CLI: List<Auto>
    CLI -> CLI: mostrar tabla de vehículos
    
    Usuario -> CLI: ingresar ID del auto
    CLI -> AutoRepository: obtenerPorId(id)
    AutoRepository -> CLI: Auto
    
    CLI -> VentaProcess: agregarAutoAVenta(auto)
    VentaProcess -> VentaProcess: ventaActual.agregarAuto(auto)
end

CLI -> VentaProcess: obtenerVentaActual()
VentaProcess -> CLI: venta actual
CLI -> ReporteVentasProcess: generarTicketVenta(venta)
ReporteVentasProcess -> ReporteVentasProcess: formatear y imprimir

CLI -> VentaProcess: finalizarVenta()
VentaProcess -> VentaRepository: guardarVenta(venta)
VentaRepository -> VentaRepository: incrementar ID y guardar

CLI -> CLI: mostrarMenuPrincipal()

@enduml
